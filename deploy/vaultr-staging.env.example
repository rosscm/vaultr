# Copy to /home/pi/.config/vaultr/staging.env with mode 0600.
VAULTR_ENVIRONMENT=staging
VAULTR_STAGING_ROOT=/home/pi/.local/share/vaultr-staging
DATABASE_PATH=/home/pi/.local/share/vaultr-staging/data/vaultr.db
CARD_CATALOG_PATH=/home/pi/.local/share/vaultr-staging/catalog/card-catalog.db
VAULTR_STAGING_LOG_PATH=/home/pi/.local/share/vaultr-staging/logs/web.log

# Startup refuses overlap with these production locations.
VAULTR_PRODUCTION_DATA_DIR=/home/pi/Documents/GitHub/vaultr/data
VAULTR_PRODUCTION_DATABASE_PATH=/home/pi/Documents/GitHub/vaultr/data/vaultr.db
VAULTR_PRODUCTION_CARD_CATALOG_PATH=/home/pi/Documents/GitHub/vaultr/data/card-catalog.db
VAULTR_PRODUCTION_WEB_PORT=8790
VAULTR_PRODUCTION_WEB_BASE_URL=https://vaultr.example

VAULTR_WEB_HOST=127.0.0.1
VAULTR_WEB_PORT=8791
VAULTR_WEB_BASE_URL=https://replace-with-staging-tunnel.example
VAULTR_WEB_POST_LOGIN_REDIRECT_PATH=/app
VAULTR_WEB_PREVIEW=false
VAULTR_WEB_ENVIRONMENT_LABEL=Staging
VAULTR_WEB_COOKIE_NAMESPACE=staging

# Use a separate Discord application. Never copy production OAuth credentials here.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Email authentication is intentionally unavailable in staging.
# Do not set POSTMARK_SERVER_TOKEN, POSTMARK_FROM_EMAIL, or VAULTR_AUTH_OUTBOX_KEY.
